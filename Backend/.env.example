# Eventory 🎬 - Backend Environment Configuration

# --- SERVER CONFIG ---
PORT=8000
NODE_ENV=production

# --- SUPABASE (Database & Auth) ---
# Use 'Anon' key for public access and 'Service Role' key (optional) for admin overrides
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_or_service_key

# --- GEMINI AI (Support Bot "Eve") ---
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# --- EMAIL SERVICE (SMTP) ---
# Use Gmail App Password for reliability (https://myaccount.google.com/apppasswords)
SMTP_EMAIL=eventorytickets@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password

# --- STRIPE (Payments) ---
# Get your keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- FRONTEND (CORS) ---
# Add your production frontend URL here (separated by commas)
CORS_ORIGIN=https://eventory-cyzy.onrender.com,http://localhost:5500
