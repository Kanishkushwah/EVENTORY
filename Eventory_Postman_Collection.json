                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"event_id\": 1,\n  \"event_title\": \"Postman Integration Test\",\n  \"event_date\": \"2026-12-31\",\n  \"event_time\": \"19:00:00\",\n  \"venue\": \"Postman Arena\",\n  \"user_email\": \"postman@testing.com\",\n  \"seats\": [\"A1\", \"A2\"],\n  \"amount_paid\": 300\n}"
                        },
                        "url": {
